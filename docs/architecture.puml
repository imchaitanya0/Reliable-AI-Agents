@startuml ReliableAIAgents-Containers
' ---------------------------------------------------------------------------
' Reliable AI Agents -- C4 Level 2 (Container diagram)
'
' Render:  plantuml docs/architecture.puml
'          or paste into https://www.plantuml.com/plantuml
'
' THE CLAIM THIS DIAGRAM MAKES:
' no container calls any other container. Every arrow ends at the database.
' That is what removes the single point of failure and the need for a
' consensus protocol. The absence of lateral arrows IS the point.
' ---------------------------------------------------------------------------
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()
title Reliable AI Agents — Container Diagram

Person(operator, "Operator", "Submits workflows and runs the failure demo")

System_Boundary(sys, "Reliable AI Agents Runtime") {

    Container(api, "Task API", "Stateless service", "Accepts workflow submissions\nand reports their status")

    Container(cli, "Control Console", "Command line", "Starts workloads, injects failures,\nshows live metrics")

    Container(orch, "Orchestrator", "Background service", "Returns work abandoned by dead workers.\nDecides whether a failure means retry,\nescalate, or give up.\nEvery instance identical — no leader")

    Container(junior, "Standard Worker Pool", "Worker processes", "Runs the everyday work.\nOne task at a time per worker.\nScale by adding processes")

    Container(senior, "Escalation Worker Pool", "Worker processes", "Runs only what the standard tier\ncould not do. Stays small because\nfew tasks ever reach it")

    Container(scaler, "Autoscaler", "Background service", "Adds or removes orchestrators\nwhen recovery falls behind")

    ContainerDb(pg, "Database", "PostgreSQL", "The only shared state.\nWork queue · ownership leases\nprogress checkpoints · full history")
}

System_Ext(ext, "External Services", "Code hosting, web endpoints,\nand the host machine")

' --- people ------------------------------------------------------------------
Rel(operator, api, "Submits workflows")
Rel(operator, cli, "Runs the demo")

' --- every container talks ONLY to the database -------------------------------
Rel(api, pg, "Records new workflows")
Rel(cli, pg, "Starts workloads, sets failure rates")
Rel_D(orch, pg, "Returns abandoned work, routes failures")
Rel_U(junior, pg, "Takes work, saves progress")
Rel_U(senior, pg, "Takes escalated work, saves progress")
Rel(scaler, pg, "Reads the recovery backlog")

' --- the one arrow that is not to the database -------------------------------
Rel_R(scaler, orch, "Adjusts how many are running")

' --- only workers reach outside ----------------------------------------------
Rel_D(junior, ext, "Calls out, when using real services")

SHOW_LEGEND()
@enduml
